# Copiar a .env y completar. Nunca subir .env al repo.
PORT=3000
NODE_ENV=development

# PostgreSQL local (infra/docker-compose.yml)
DATABASE_URL="postgresql://emenu:emenu@localhost:5432/emenu?schema=public"

# Orígenes permitidos (separados por coma)
CORS_ORIGINS="http://localhost:3001,https://gopicadera.online,https://www.gopicadera.online"

# Fase 1+: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET (obligatorios, sin valor por defecto)
# Fase 2+: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, FIREBASE_SERVICE_ACCOUNT_JSON, STORAGE_*
