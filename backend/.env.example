# Copiar a .env y completar. Nunca subir .env al repo.
PORT=3000
NODE_ENV=development

# PostgreSQL local (infra/docker-compose.yml)
DATABASE_URL="postgresql://emenu:emenu@localhost:5432/emenu?schema=public"

# Orígenes permitidos (separados por coma)
CORS_ORIGINS="http://localhost:3001,http://localhost:5000,http://localhost:5001,https://gopicadera.online,https://www.gopicadera.online,http://localhost:5002"

# Seguridad (obligatorios, mínimo 32 caracteres, distintos por instalación).
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
PIN_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30

# Seed inicial (npm run db:seed): crea roles, ajustes y el primer administrador
SEED_RESTAURANT_NAME="Picadera"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Imágenes (fotos de productos y categorías)
#   local: se guardan en STORAGE_LOCAL_DIR y se sirven en PUBLIC_BASE_URL/uploads (desarrollo)
#   s3:    Cloudflare R2, Supabase Storage o cualquier servicio compatible con S3 (producción)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://imagenes.tudominio.com

# Pagos en línea (Stripe). En desarrollo usa las claves de PRUEBA (sk_test_ / pk_test_).
# Sin STRIPE_SECRET_KEY la web solo ofrece "pagar al recoger".
# NUNCA subas estas claves a GitHub ni las compartas por chat.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Opcional en desarrollo: lo da `stripe listen` o el panel de Stripe → Webhooks.
STRIPE_WEBHOOK_SECRET=

# Notificaciones push (Firebase Cloud Messaging): ruta al archivo de la cuenta de servicio.
# Se descarga en Firebase → Configuración del proyecto → Cuentas de servicio. Es SECRETO:
# la carpeta secrets/ no se sube a GitHub.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
