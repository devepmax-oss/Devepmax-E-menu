{
  "name": "@devepmax-emenu/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Devepmax E-Menu — backend (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
