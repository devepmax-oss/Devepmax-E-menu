    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "db:seed": "prisma db seed",
    "smoke:orders": "tsx scripts/smoke-orders.ts",
    "smoke:promotions": "tsx scripts/smoke-promotions.ts",
    "smoke:realtime": "tsx scripts/smoke-realtime.ts",
    "smoke:online": "tsx scripts/smoke-online.ts",
    "smoke:delivery": "tsx scripts/smoke-delivery.ts",
    "smoke:tables": "tsx scripts/smoke-tables.ts",
    "smoke:emenu": "tsx scripts/smoke-emenu.ts",
    "smoke:billing": "tsx scripts/smoke-billing.ts",
    "smoke:terminal": "tsx scripts/smoke-terminal.ts",
    "smoke:tablepay": "tsx scripts/smoke-tablepay.ts",
    "smoke:refunds": "tsx scripts/smoke-refunds.ts",
    "smoke:kds": "tsx scripts/smoke-kds.ts",
    "smoke:waiter": "tsx scripts/smoke-waiter.ts",
    "smoke:report": "tsx scripts/smoke-report.ts",
    "smoke:customers": "tsx scripts/smoke-customers.ts",
    "smoke:coupons": "tsx scripts/smoke-coupons.ts",
    "smoke:loyalty": "tsx scripts/smoke-loyalty.ts",
    "smoke:inventory": "tsx scripts/smoke-inventory.ts",
    "demo:orders": "tsx scripts/demo-orders.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.11",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/websockets": "^11.2.11",
    "@prisma/client": "6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.0",
    "socket.io": "^4.8.4",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "prisma": "6.15.0",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
